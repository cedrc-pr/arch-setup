{
  "lsp": {
    "eslint": {
      "settings": {
        "rules": {
          "react-refresh/only-export-components": "off",
        },
      },
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "vim_mode": true,
  "inline_code_actions": false,
  "format_on_save": "on",
  "code_actions_on_format": {
    "source.organizeImports": true,
  },
  "project_panel": {
    "dock": "left",
  },
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light Soft",
    "dark": "Gruvbox Dark Soft",
  },
  "theme_overrides": {
    "Gruvbox Dark Soft": {
      "error.background": "#00000000",
      "error.border": "#e05050a0",
    },
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "languages": {
    "HTML": {
      "tab_size": 2,
      "hard_tabs": false,
    },
  },
}
